# ReBook Central API
# Public frontend URL used in generated shop/payment links.
# Local: http://localhost:8443
# Vercel: https://YOUR-PROJECT.vercel.app
APP_BASE_URL=
FRONTEND_BASE_URL=
REBOOK_API_PORT=5000
REBOOK_API_URL=http://localhost:5000

# Super Admin
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
MASTER_ENCRYPTION_KEY=64-hex-characters

# Central Firebase service account (project used only for ReBook control/billing metadata)
CENTRAL_FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"","private_key_id":"","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"","client_id":""}

# Razorpay (server-side only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Vercel Cron
CRON_SECRET=replace-with-a-long-random-secret

# Optional safety switch. Keep false for production unless you deliberately need cloud reset.
ALLOW_CLOUD_RESET=false

# Demo-only WhatsApp test PIN (server-side). Current demo PIN: 7439
DEMO_WHATSAPP_PIN=7439
