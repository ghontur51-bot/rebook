# ReBook Central API
APP_BASE_URL=
FRONTEND_BASE_URL=
REBOOK_API_PORT=5000
REBOOK_API_URL=http://localhost:5000

# Super Admin
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
MASTER_ENCRYPTION_KEY=64-hex-characters

# Central Firebase service account (server-side only)
CENTRAL_FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"","private_key_id":"","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"","client_id":""}

# Razorpay (server-side only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Vercel Cron
CRON_SECRET=replace-with-a-long-random-secret

# Demo WhatsApp gate
# Current demo PIN is intentionally fixed at 7439.
DEMO_WHATSAPP_PIN=7439
DEMO_WHATSAPP_SHOP_ID=rebook-demo-test

# WhatsApp worker secrets/config
WHATSAPP_BRIDGE_SECRET=generate-a-long-random-secret
AUTOMATION_CALLBACK_SECRET=use-the-same-secret-for-ReBook-and-the-Sandbox-worker
WHATSAPP_MAX_SESSIONS=2
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_MAX_RECIPIENTS=100
WHATSAPP_MAX_AUTOMATION_RECIPIENTS=150
WHATSAPP_AUTOMATION_DELAY_MS=2000
WHATSAPP_MANUAL_DELAY_MS=5000

# Vercel Sandbox
REBOOK_SANDBOX_NAME=rebook-whatsapp-worker
REBOOK_SANDBOX_PROJECT_ID=prj_DSQLRKITHzL5lBtWruqVZsaGv8D8
REBOOK_SANDBOX_VCPUS=4
# Hobby limit is 45 minutes; Pro/Enterprise can use a longer session.
REBOOK_SANDBOX_TIMEOUT_MS=2700000
REBOOK_SANDBOX_SNAPSHOT_TTL_MS=1209600000
# On Vercel, OIDC is supplied by the platform. Outside Vercel, set VERCEL_TOKEN.

# Optional safety switch
ALLOW_CLOUD_RESET=false

# Production deployment uses the main branch.

# Server-side request timeout for Sandbox bootstrap/proxying (under the Vercel 60s API limit)
WHATSAPP_SANDBOX_REQUEST_TIMEOUT_MS=55000
