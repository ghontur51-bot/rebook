{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "wa-bridge": "node server/whatsapp-bridge.cjs",
    "api": "node server/rebook-api.cjs",
    "dev:notes": "node -e \"console.log('Start API: npm run api | Start frontend: npm run dev | Start WhatsApp: npm run wa-bridge')\"",
